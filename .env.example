# Supabase 프로젝트 설정 > API 에서 복사
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# Publishable key(sb_publishable_...) 또는 기존 anon key. 브라우저에 노출되어도 되는 키이며 RLS가 데이터를 보호한다.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# E2E 테스트용 로그인 계정(선택). 실제 계정과 분리된 테스트 계정을 권장.
E2E_EMAIL=
E2E_PASSWORD=

# Google Gemini API (AI 트레이너). 서버 전용 — NEXT_PUBLIC_ 접두사를 붙이지 마세요.
GEMINI_API_KEY=
# 선택: 기본 모델(기본 gemini-3.8-flash), 과부하 시 대체 모델(기본 gemini-3.5-flash), 24시간 AI 요청 한도(기본 50)
GEMINI_MODEL=
AI_DAILY_LIMIT=

GEMINI_FALLBACK_MODEL=
